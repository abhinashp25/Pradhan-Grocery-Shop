{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../../frontend/node_modules/@supabase/supabase-js"],
      "npm:@supabase/supabase-js@*": ["../../../frontend/node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["./**/*.ts"]
}
